{
  "manifest_version": 3,
  "name": "Reflex — Upwork copilot",
  "version": "0.1.0",
  "description": "A productivity layer on top of Upwork: check jobs, generate proposals, and suggest replies. UI demo scaffold (mocked, no backend).",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Reflex",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.upwork.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.upwork.com/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*",
    "https://drive.google.com/*",
    "https://*.googleusercontent.com/*"
  ]
}
